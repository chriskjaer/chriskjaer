@layout "../includes/layout.smol"

@title Snake — projects — chriskjaer
@description A tiny monochrome Snake game whose deterministic core is compiled from Smol to WebAssembly.
@viewport width=device-width, initial-scale=1
@lang en
@charset utf-8
@set canonical_url https://chriskjaer.com/projects/snake/

@wasm snake as snake_wasm
  # A deterministic 40 × 18 board, rendered as 2 × 2 pixels on an 84 × 48 LCD.
  @vars
    memory_pages 1
    board_address 0
    snake_x_address 1024
    snake_y_address 2048
    head_address 4096
    tail_address 4100
    length_address 4104
    direction_address 4108
    pending_address 4112
    queued_address 4116
    rng_address 4120
    status_address 4124
    score_address 4128
    board_width 40
    board_height 18
    board_size 720
    random_multiplier 1664525
    random_increment 1013904223

  @memory memory_pages
    @array board at board_address
    @array snake_x at snake_x_address
    @array snake_y at snake_y_address
    @state head at head_address
    @state tail at tail_address
    @state length at length_address
    @state direction at direction_address
    @state pending at pending_address
    @state queued at queued_address
    @state rng at rng_address
    @state status at status_address
    @state score_value at score_address
  @export memory

  @func ptr -> i32 export
    @return board_address

  @func score -> i32 export
    @return score_value

  @func reset seed:i32 export
    @for index in 0 .. board_size
      @set board[index] = 0
      @set snake_x[index] = 0
      @set snake_y[index] = 0

    @set tail = 0
    @set head = 2
    @set length = 3
    @set direction = 0
    @set pending = 0
    @set queued = 0
    @set status = 1
    @set score_value = 0
    @set rng = max_u(seed, 1)

    @set snake_x[0] = 18
    @set snake_y[0] = 9
    @set snake_x[1] = 19
    @set snake_y[1] = 9
    @set snake_x[2] = 20
    @set snake_y[2] = 9
    @set board[378] = 1
    @set board[379] = 1
    @set board[380] = 1

    @set rng = rng * random_multiplier + random_increment
    @let random_index:i32 = choose(rng >u 2147483647, 0 - (rng + 1), rng)
    @let start:i32 = random_index %s board_size
    @let selected:i32 = 0 - 1
    @for offset in 0 .. board_size
      @let candidate:i32 = (start + offset) %s board_size
      @set selected = choose(selected == 0 - 1 and board[candidate] == 0, candidate, selected)
    @set board[selected] = 2

  @func turn requested:i32 export
    @return if status != 1 or queued != 0 or requested >u 3
    @return if (requested + 2) %s 4 == direction
    @set pending = requested
    @set queued = 1

  @func step -> i32 export
    @let active:i32 = status == 1
    @set direction = choose(active, pending, direction)
    @set queued = 0

    @let hx:i32 = snake_x[head]
    @let hy:i32 = snake_y[head]
    @let dx:i32 = choose(direction == 0, 1, choose(direction == 2, 0 - 1, 0))
    @let dy:i32 = choose(direction == 1, 1, choose(direction == 3, 0 - 1, 0))
    @let nx:i32 = hx + dx
    @let ny:i32 = hy + dy
    @let outside:i32 = nx >u board_width - 1 or ny >u board_height - 1
    @let safe_x:i32 = choose(outside, 0, nx)
    @let safe_y:i32 = choose(outside, 0, ny)
    @let next_cell:i32 = safe_y * board_width + safe_x
    @let eating:i32 = board[next_cell] == 2
    @let occupied:i32 = board[next_cell] == 1
    @let tail_cell:i32 = snake_y[tail] * board_width + snake_x[tail]
    @let tail_match:i32 = next_cell == tail_cell
    @let collision:i32 = outside or occupied and (eating or tail_match == 0)
    @let moving:i32 = active and collision == 0
    @set status = choose(active and collision, 0, status)

    @set board[tail_cell] = choose(moving and eating == 0, 0, board[tail_cell])
    @let next_head:i32 = (head + 1) %s board_size
    @set snake_x[next_head] = choose(moving, safe_x, snake_x[next_head])
    @set snake_y[next_head] = choose(moving, safe_y, snake_y[next_head])
    @set board[next_cell] = choose(moving, 1, board[next_cell])
    @set head = choose(moving, next_head, head)
    @set tail = choose(moving and eating == 0, (tail + 1) %s board_size, tail)
    @set length = length + (moving and eating)
    @set score_value = score_value + (moving and eating)

    @let spawning:i32 = moving and eating
    @set rng = choose(spawning, rng * random_multiplier + random_increment, rng)
    @let food_random_index:i32 = choose(rng >u 2147483647, 0 - (rng + 1), rng)
    @let food_start:i32 = food_random_index %s board_size
    @let food_cell:i32 = 0 - 1
    @for food_offset in 0 .. board_size
      @let food_candidate:i32 = (food_start + food_offset) %s board_size
      @set food_cell = choose(spawning and food_cell == 0 - 1 and board[food_candidate] == 0, food_candidate, food_cell)
    @let safe_food:i32 = choose(food_cell == 0 - 1, 0, food_cell)
    @set board[safe_food] = choose(spawning and food_cell != 0 - 1, 2, board[safe_food])
    @set status = choose(spawning and food_cell == 0 - 1, 2, status)

    @return status

:head
  style
    body
      overflow: auto
    .page
      justify-content: flex-start
      padding: 3rem 1rem 5rem
    .project
      width: 100%
      max-width: 42rem
    .nav
      font-size: .75rem
      margin-bottom: 2rem
    .title
      font-family: Palatino Linotype, Palatino, Palladio, URW Palladio L, ui-serif, Georgia, Cambria, "Times New Roman", Times, serif
      font-size: 2.25rem
      line-height: 1.1
      margin: 0 0 .65rem
    .subtitle
      color: #4b5563
      font-size: .95rem
      line-height: 1.55
      margin: 0 0 2rem
      max-width: 38rem
    .phone
      background: #30342f
      border: .35rem solid #242823
      border-radius: 2.2rem 2.2rem 1.4rem 1.4rem
      box-shadow: inset 0 0 0 .15rem #51574f, 0 .6rem 1.5rem rgb(17 24 39 / .15)
      margin: 0 auto
      max-width: 32rem
      padding: 1.8rem 1.4rem 1.25rem
    .speaker
      background: #151815
      border-radius: 99rem
      height: .35rem
      margin: 0 auto 1.1rem
      opacity: .8
      width: 4.5rem
    .lcd-shell
      background: #89917d
      border: .45rem solid #171b17
      border-radius: .35rem
      box-shadow: inset 0 0 1rem rgb(34 48 31 / .3)
      padding: .55rem
    .screen
      background: #b7c59d
      display: block
      image-rendering: pixelated
      margin: 0 auto
      outline: none
      width: min(100%, 26.25rem)
      aspect-ratio: 7 / 4
      touch-action: none
    .screen:focus-visible
      outline: .18rem solid #d86738
      outline-offset: .65rem
    .game-status
      color: #d8ddd1
      display: flex
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace
      font-size: .7rem
      justify-content: space-between
      margin: .8rem .15rem .55rem
      min-height: 1rem
    .controls
      display: grid
      gap: .45rem
      grid-template-columns: repeat(3, minmax(3rem, 1fr))
      margin: 0 auto
      max-width: 14rem
    .control
      appearance: none
      background: #202420
      border: 1px solid #636a61
      border-radius: .75rem
      box-shadow: inset 0 -.15rem 0 #101310
      color: #e8ebe4
      cursor: pointer
      font: 700 1rem/1 ui-sans-serif, system-ui, sans-serif
      min-height: 2.8rem
    .control:hover
      background: #292e29
    .control:focus-visible
      outline: .18rem solid #d86738
      outline-offset: .12rem
    .control.up
      grid-column: 2
      grid-row: 1
    .control.left
      grid-column: 1
      grid-row: 2
    .control.action
      grid-column: 2
      grid-row: 2
      font-size: .65rem
      letter-spacing: .05em
      text-transform: uppercase
    .control.right
      grid-column: 3
      grid-row: 2
    .control.down
      grid-column: 2
      grid-row: 3
    .instructions
      color: #4b5563
      font-size: .8rem
      line-height: 1.5
      margin: 1.5rem auto 0
      max-width: 30rem
      text-align: center
    .noscript
      background: #fff7ed
      border: 1px solid #fed7aa
      padding: .75rem
    @media (max-width: 34rem)
      .page
        padding-top: 2rem
      .phone
        border-radius: 1.6rem 1.6rem 1rem 1rem
        padding: 1.2rem .85rem 1rem
      .control
        min-height: 3.2rem
    @media (prefers-reduced-motion: reduce)
      .phone
        scroll-behavior: auto

:body
  main.page
    article.project
      nav.nav
        a(href="/") ← Home
        | ·
        a(href="/projects/smol") Smol
      h1.title | Snake
      p.subtitle | A tiny LCD game with its deterministic core written beside this page in Smol, then compiled to WebAssembly by AWK.

      section.phone#snake-game(tabindex="-1" aria-label="Snake game")
        .speaker
        .lcd-shell
          canvas.screen#snake-screen(width="84" height="48" tabindex="0" role="img" aria-label="Snake board. Focus here and use arrow keys or WASD to steer.")
        .game-status(aria-live="polite")
          span#snake-state | Ready
          span#snake-score | Score 00
        .controls(role="group" aria-label="Snake controls")
          button.control.up(type="button" data-dir="3" aria-label="Up") ↑
          button.control.left(type="button" data-dir="2" aria-label="Left") ←
          button.control.action#snake-action(type="button") Start
          button.control.right(type="button" data-dir="0" aria-label="Right") →
          button.control.down(type="button" data-dir="1" aria-label="Down") ↓
      p.instructions | Arrow keys or WASD steer. Space or Enter starts and pauses. On touch, use the pad or swipe across the screen.
      noscript
        p.noscript | Snake needs JavaScript and WebAssembly enabled.

script
  :raw
    (() => {
      const game = document.getElementById("snake-game");
      const canvas = document.getElementById("snake-screen");
      const action = document.getElementById("snake-action");
      const stateLabel = document.getElementById("snake-state");
      const scoreLabel = document.getElementById("snake-score");
      if (!game || !canvas || !action || !stateLabel || !scoreLabel) return;

      const context = canvas.getContext("2d", { alpha: false });
      context.imageSmoothingEnabled = false;
      const width = 40;
      const height = 18;
      let api;
      let board;
      let timer = 0;
      let running = false;
      let ended = false;
      let touchStart = null;

      const fitScreen = () => {
        const shell = canvas.parentElement;
        const shellStyle = getComputedStyle(shell);
        const available = shell.clientWidth
          - parseFloat(shellStyle.paddingLeft)
          - parseFloat(shellStyle.paddingRight);
        const dpr = window.devicePixelRatio || 1;
        const scale = Math.max(1, Math.floor((available * dpr) / 84));
        canvas.style.width = `${(84 * scale) / dpr}px`;
        canvas.style.height = `${(48 * scale) / dpr}px`;
      };

      const setState = (text) => {
        stateLabel.textContent = text;
        action.textContent = ended ? "Restart" : running ? "Pause" : api ? "Start" : "Loading";
      };

      const drawText = (text, x, y, align = "left") => {
        context.font = "bold 5px monospace";
        context.textAlign = align;
        context.fillText(text, x, y);
      };

      const draw = () => {
        context.fillStyle = "#b7c59d";
        context.fillRect(0, 0, 84, 48);
        context.fillStyle = "#273324";
        drawText(`SCORE ${String(api ? api.score() : 0).padStart(2, "0")}`, 2, 6);
        drawText(running ? "●" : "Ⅱ", 81, 6, "right");
        context.fillRect(2, 8, 80, 1);
        if (!board) {
          drawText("LOADING", 42, 29, "center");
          return;
        }
        for (let index = 0; index < board.length; index += 1) {
          if (!board[index]) continue;
          const x = 2 + (index % width) * 2;
          const y = 10 + Math.floor(index / width) * 2;
          if (board[index] === 1) {
            context.fillRect(x, y, 2, 2);
          } else {
            context.fillRect(x, y, 2, 1);
            context.fillRect(x, y + 1, 1, 1);
          }
        }
        if (!running) {
          context.fillStyle = "#b7c59d";
          context.fillRect(20, 21, 44, 10);
          context.strokeStyle = "#273324";
          context.strokeRect(20.5, 21.5, 43, 9);
          context.fillStyle = "#273324";
          drawText(ended ? "GAME OVER" : "PRESS START", 42, 28, "center");
        }
      };

      const schedule = () => {
        clearTimeout(timer);
        if (!running) return;
        const delay = Math.max(75, 165 - api.score() * 4);
        timer = setTimeout(tick, delay);
      };

      const tick = () => {
        if (!running) return;
        const status = api.step();
        scoreLabel.textContent = `Score ${String(api.score()).padStart(2, "0")}`;
        if (status !== 1) {
          running = false;
          ended = true;
          setState(status === 2 ? "You win" : "Game over");
        }
        draw();
        schedule();
      };

      const reset = () => {
        const seed = (Date.now() ^ Math.floor(performance.now() * 1000)) | 0;
        api.reset(seed);
        board = new Uint8Array(api.memory.buffer, api.ptr(), width * height);
        ended = false;
        scoreLabel.textContent = "Score 00";
      };

      const toggle = () => {
        if (!api) return;
        if (ended || !board) reset();
        running = !running;
        setState(running ? "Playing" : "Paused");
        draw();
        schedule();
        canvas.focus({ preventScroll: true });
      };

      const steer = (direction) => {
        if (!api) return;
        if (!board) reset();
        api.turn(direction);
        if (!running && !ended) {
          running = true;
          setState("Playing");
          schedule();
        }
        draw();
      };

      const keys = new Map([
        ["ArrowRight", 0], ["d", 0], ["D", 0],
        ["ArrowDown", 1], ["s", 1], ["S", 1],
        ["ArrowLeft", 2], ["a", 2], ["A", 2],
        ["ArrowUp", 3], ["w", 3], ["W", 3]
      ]);

      game.addEventListener("keydown", (event) => {
        if ((event.key === " " || event.key === "Enter") && event.target.closest("button")) return;
        if (keys.has(event.key)) {
          event.preventDefault();
          steer(keys.get(event.key));
        } else if (event.key === " " || event.key === "Enter") {
          event.preventDefault();
          toggle();
        }
      });

      action.addEventListener("click", toggle);
      game.querySelectorAll("[data-dir]").forEach((button) => {
        button.addEventListener("click", () => {
          steer(Number(button.dataset.dir));
          canvas.focus({ preventScroll: true });
        });
      });

      canvas.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "touch") touchStart = [event.clientX, event.clientY];
      });
      canvas.addEventListener("pointerup", (event) => {
        if (!touchStart || event.pointerType !== "touch") return;
        const dx = event.clientX - touchStart[0];
        const dy = event.clientY - touchStart[1];
        touchStart = null;
        if (Math.max(Math.abs(dx), Math.abs(dy)) < 16) return;
        steer(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 0 : 2) : (dy > 0 ? 1 : 3));
      });

      window.addEventListener("resize", fitScreen);
      fitScreen();
      draw();
      fetch("#{snake_wasm}")
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.arrayBuffer();
        })
        .then((bytes) => WebAssembly.instantiate(bytes, {}))
        .then(({ instance }) => {
          api = instance.exports;
          reset();
          setState("Ready");
          draw();
        })
        .catch(() => {
          stateLabel.textContent = "Could not load game";
          action.disabled = true;
          draw();
        });
    })();
