@layout "includes/layout.smol"

@title Chris Kjær | Co-founder and CTO at Landfolk
@description Co-founder and CTO at Landfolk, exploring how AI changes what ambitious teams can build.
@viewport width=device-width, initial-scale=1
@lang en
@charset utf-8

@vars
  name "Chris Kjær Bruhn Sørensen"
  landfolk_url https://landfolk.com
  gaest_url https://techcrunch.com/2019/01/25/airbnb-acquires-denmarks-gaest-to-expand-in-bookings-for-meetings-and-offsites
  linkedin_url https://www.linkedin.com/in/chriskjaer/
  github_url https://github.com/chriskjaer
  canonical_url https://chriskjaer.com/

:body
  canvas#life.life
  main.page
    .intro
      @include includes/logo.smol logo_class=logo
      .copy
        h1.name | #{name}
        p.role
          | Co-founder &amp; CTO at
          a(href="#{landfolk_url}") Landfolk,
          br.break
          | exploring how AI changes what ambitious teams can build.
        p.past
          | Previously: Co-Founder of
          a(href="#{gaest_url}") Gaest.com
          | , ex-Airbnb.
    .links
      a(href="#{linkedin_url}") LinkedIn
      a(href="#{github_url}") GitHub
      a(href="/books") Books
      a(href="/pax") Pax

  @include includes/life.smol
