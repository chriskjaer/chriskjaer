# Wasmol: the tiny subset of WebAssembly this site actually needs.
# Compiled by scripts/wasmol.awk using only POSIX AWK.

# Fixed memory layout shared with the browser renderer.
const memory_pages = 47
const width_address = 1048576
const height_address = 1048580
const cells_address = 1048584
const next_cells_address = 2048584
const max_cells_exclusive = 1000001

# Parameters for deterministic seeding.
const random_multiplier = 1664525
const random_increment = 1013904223
const u32_range = 4294967296
const i32_min = -2147483648

memory memory memory_pages

export memory memory
export func set_size
export func ptr
export func seed
export func splat
export func step

func set_size cols:i32 rows:i32
  block done
    block sized
      block zero
        local.get cols
        i32.eqz
        br_if zero
        local.get rows
        i32.eqz
        br_if zero
        loop shrink
          local.get cols
          local.get rows
          i32.mul
          local.tee size:i32
          i32.const max_cells_exclusive
          i32.lt_u
          br_if sized
          local.get cols
          local.get rows
          i32.gt_u
          local.set size
          local.get rows
          local.get cols
          local.get rows
          i32.le_u
          i32.sub
          local.set rows
          local.get cols
          local.get size
          i32.sub
          local.set cols
          br shrink
        end
      end
      i32.const 0
      i32.const 0
      i32.store offset=height_address
      i32.const 0
      i32.const 0
      i32.store offset=width_address
      br done
    end
    i32.const 0
    local.get rows
    i32.store offset=height_address
    i32.const 0
    local.get cols
    i32.store offset=width_address
    i32.const 0
    local.set cols
    loop clear
      local.get size
      local.get cols
      i32.eq
      br_if done
      local.get cols
      i32.const next_cells_address
      i32.add
      i32.const 0
      i32.store8
      local.get cols
      i32.const cells_address
      i32.add
      i32.const 0
      i32.store8
      local.get cols
      i32.const 1
      i32.add
      local.set cols
      br clear
    end
  end
endfunc

func ptr -> i32
  i32.const cells_address
endfunc

func seed density:f32 index:i32
  block done
    i32.const 0
    i32.load offset=width_address
    local.tee width:i32
    i32.eqz
    br_if done
    i32.const 0
    i32.load offset=height_address
    local.tee height:i32
    i32.eqz
    br_if done
    f32.const 1
    f32.const 0
    local.get density
    local.get density
    f32.const 0
    f32.lt
    select
    local.tee density
    local.get density
    f32.const 1
    f32.gt
    select
    f32.const u32_range
    f32.mul
    i32.trunc_sat_f32_u
    local.set threshold:i32
    local.get index
    i32.const 1
    local.get index
    i32.const 1
    i32.gt_u
    select
    local.set rng:i32
    local.get height
    local.get width
    i32.mul
    local.set width
    i32.const 0
    local.set index
    loop fill
      local.get width
      local.get index
      i32.eq
      br_if done
      local.get index
      i32.const next_cells_address
      i32.add
      i32.const 0
      i32.store8
      local.get index
      i32.const cells_address
      i32.add
      local.get rng
      i32.const random_multiplier
      i32.mul
      i32.const random_increment
      i32.add
      local.tee rng
      local.get threshold
      i32.le_u
      i32.store8
      local.get index
      i32.const 1
      i32.add
      local.set index
      br fill
    end
  end
endfunc

func splat x:i32 y:i32
  block done
    i32.const 0
    i32.load offset=width_address
    local.tee width:i32
    i32.eqz
    br_if done
    i32.const 0
    i32.load offset=height_address
    local.tee height:i32
    i32.eqz
    br_if done
    i32.const -2
    local.set dy:i32
    loop y_loop
      local.get dy
      i32.const 3
      i32.eq
      br_if done
      local.get height
      i32.const 0
      local.get dy
      local.get y
      i32.add
      local.get height
      i32.rem_s
      local.tee dx:i32
      i32.const i32_min
      i32.gt_u
      select
      local.get dx
      i32.add
      local.tee dx
      i32.const 31
      i32.shr_s
      local.get height
      i32.and
      local.get dx
      i32.add
      local.get width
      i32.mul
      local.set row:i32
      i32.const -2
      local.set dx
      block next_y
        loop x_loop
          local.get dx
          i32.const 3
          i32.eq
          br_if next_y
          local.get row
          local.get width
          i32.const 0
          local.get x
          local.get dx
          i32.add
          local.get width
          i32.rem_s
          local.tee wrapped:i32
          i32.const i32_min
          i32.gt_u
          select
          local.get wrapped
          i32.add
          local.tee wrapped
          i32.const 31
          i32.shr_s
          local.get width
          i32.and
          local.get wrapped
          i32.add
          i32.add
          i32.const cells_address
          i32.add
          i32.const 1
          i32.store8
          local.get dx
          i32.const 1
          i32.add
          local.set dx
          br x_loop
        end
      end
      local.get dy
      i32.const 1
      i32.add
      local.set dy
      br y_loop
    end
  end
endfunc

func step
  block done
    i32.const 0
    i32.load offset=width_address
    local.tee width:i32
    i32.eqz
    br_if done
    i32.const 0
    i32.load offset=height_address
    local.tee height:i32
    i32.eqz
    br_if done
    local.get width
    i32.const -1
    i32.add
    local.set last_x:i32
    i32.const 0
    local.set row_offset:i32
    i32.const 0
    local.set y:i32
    loop y_loop
      block compute_row
        local.get y
        local.get height
        i32.ne
        br_if compute_row
        local.get height
        local.get width
        i32.mul
        local.set y
        i32.const 0
        local.set x:i32
        loop copy_loop
          local.get y
          local.get x
          i32.eq
          br_if done
          local.get x
          i32.const cells_address
          i32.add
          local.get x
          i32.const next_cells_address
          i32.add
          i32.load8_u
          i32.store8
          local.get x
          i32.const 1
          i32.add
          local.set x
          br copy_loop
        end
      end
      i32.const 0
      local.set x
      i32.const 0
      local.get y
      i32.const 1
      i32.add
      local.tee next_y:i32
      local.get next_y
      local.get height
      i32.eq
      select
      local.get width
      i32.mul
      local.tee down_row:i32
      i32.const cells_address
      i32.add
      local.set down_ptr:i32
      local.get y
      local.get width
      i32.mul
      local.set row_base:i32
      local.get y
      local.get height
      local.get y
      select
      i32.const -1
      i32.add
      local.get width
      i32.mul
      local.tee up_row:i32
      i32.const cells_address
      i32.add
      local.set up_ptr:i32
      block next_row
        loop x_loop
          local.get width
          local.get x
          i32.eq
          br_if next_row
          local.get row_offset
          local.get x
          i32.add
          local.tee index:i32
          i32.const next_cells_address
          i32.add
          local.get up_ptr
          local.get x
          i32.add
          i32.load8_u
          local.get x
          local.get width
          local.get x
          select
          i32.const -1
          i32.add
          local.tee y
          local.get up_row
          i32.add
          i32.const cells_address
          i32.add
          i32.load8_u
          i32.add
          i32.const 0
          local.get x
          i32.const 1
          i32.add
          local.tee next_x:i32
          local.get last_x
          local.get x
          i32.eq
          select
          local.tee wrapped_x:i32
          local.get up_row
          i32.add
          i32.const cells_address
          i32.add
          i32.load8_u
          i32.add
          local.get y
          local.get row_base
          i32.add
          i32.const cells_address
          i32.add
          i32.load8_u
          i32.add
          local.get wrapped_x
          local.get row_base
          i32.add
          i32.const cells_address
          i32.add
          i32.load8_u
          i32.add
          local.get y
          local.get down_row
          i32.add
          i32.const cells_address
          i32.add
          i32.load8_u
          i32.add
          local.get down_ptr
          local.get x
          i32.add
          i32.load8_u
          i32.add
          local.get wrapped_x
          local.get down_row
          i32.add
          i32.const cells_address
          i32.add
          i32.load8_u
          i32.add
          local.tee x
          i32.const 254
          i32.and
          i32.const 2
          i32.eq
          local.get x
          i32.const 255
          i32.and
          i32.const 3
          i32.eq
          local.get index
          i32.const cells_address
          i32.add
          i32.load8_u
          i32.const 1
          i32.eq
          select
          i32.store8
          local.get next_x
          local.set x
          br x_loop
        end
      end
      local.get row_offset
      local.get width
      i32.add
      local.set row_offset
      local.get next_y
      local.set y
      br y_loop
    end
  end
endfunc
