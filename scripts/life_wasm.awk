#!/usr/bin/awk -f

# A tiny, purpose-built WebAssembly assembler for the site's Game of Life.
# It emits the complete module directly from shell-era tools: no Zig, wat2wasm,
# package manager, or language runtime required.

function emit_byte(value) {
  printf "%c", value
}

function emit_hex(hex,   i) {
  for (i = 1; i <= length(hex); i += 2) {
    emit_byte((hex_value(substr(hex, i, 1)) * 16) + hex_value(substr(hex, i + 1, 1)))
  }
}

function hex_value(digit) {
  digit = tolower(digit)
  if (digit >= "0" && digit <= "9") return digit + 0
  return index("abcdef", digit) + 9
}

function uleb(value,   byte, encoded) {
  encoded = ""
  do {
    byte = value % 128
    value = int(value / 128)
    if (value > 0) byte += 128
    encoded = encoded sprintf("%02x", byte)
  } while (value > 0)
  return encoded
}

function section(id, payload) {
  emit_hex(sprintf("%02x", id) uleb(length(payload) / 2) payload)
}

function function_body(opcodes) {
  return uleb(length(opcodes) / 2) opcodes
}

BEGIN {
  # WebAssembly magic and version 1.
  emit_hex("0061736d01000000")

  # Types: set_size(i32,i32), ptr()->i32, seed(f32,i32), step/splat variants.
  section(1, "0460027f7f006000017f60027d7f00600000")

  # Five functions referring to the four signatures above.
  section(3, "050001020003")

  # One 47-page linear memory and one mutable i32 stack-pointer global.
  section(5, "01002f")
  section(6, "017f01418080c0000b")

  # memory, set_size, ptr, seed, splat, step.
  section(7, "06066d656d6f72790200087365745f73697a650000037074720001047365656400020573706c6174000304737465700004")

  # Function bodies. These are WebAssembly opcodes, grouped by exported function
  # rather than an opaque copy of the final .wasm file.
  set_size = ""
  ptr = "00418880c080000b"
  seed = ""
  splat = ""
  step = ""

  code = "05" function_body(set_size) function_body(ptr) function_body(seed) function_body(splat) function_body(step)
  section(10, code)
}
